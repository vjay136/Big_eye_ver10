{
  "manifest_version": 3,
  "name": "Big Eye",
  "version": "1.0.1",
  "description": "Run local phishing signal checks on pasted messages and URLs.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Big Eye"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "version_name": "1.0.1 (release 2)"
}
